model Section {
  id            String             @id @default(uuid()) @db.Uuid
  sectionNumber String
  courseId      String             @db.Uuid
  semesterId    String             @db.Uuid
  instructorId  String?            @db.Uuid
  capacity      Int
  enrolledCount Int                @default(0)
  schedule      Json
  room          String?
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  course        Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semester      Semester           @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  instructor    InstructorProfile? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  enrollments   Enrollment[]

  @@unique([courseId, semesterId, sectionNumber])
  @@index([courseId])
  @@index([semesterId])
  @@index([instructorId])
  @@index([deletedAt])
}
