model Department {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  code        String              @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  instructors InstructorProfile[]
  programs    Program[]

  @@index([name])
  @@index([deletedAt])
}
