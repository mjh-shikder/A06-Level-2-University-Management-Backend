model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}
