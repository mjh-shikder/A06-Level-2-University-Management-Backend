model Result {
  id                   String       @id @default(uuid()) @db.Uuid
  enrollmentId         String       @unique @db.Uuid
  totalWeightedPercent Decimal      @db.Decimal(5, 2)
  letterGrade          String
  gradePoint           Decimal      @db.Decimal(3, 2)
  status               ResultStatus @default(DRAFT)
  publishedAt          DateTime?
  publishedBy          String?      @db.Uuid
  deletedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  enrollment           Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  publisher            User?        @relation("ResultPublisher", fields: [publishedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedBy])
  @@index([deletedAt])
}
