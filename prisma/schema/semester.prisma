model Semester {
  id                String         @id @default(uuid()) @db.Uuid
  name              String
  year              Int
  term              String
  status            SemesterStatus @default(UPCOMING)
  registrationStart DateTime?
  registrationEnd   DateTime?
  startDate         DateTime
  endDate           DateTime
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([year, term])
  @@index([status])
  @@index([year])
  @@index([deletedAt])
}
