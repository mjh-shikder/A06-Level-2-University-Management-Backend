# Server Environment
NODE_ENV=development
PORT=5000

# Database Connection (Prisma 7 Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/university_management?schema=public

# Client & Server URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000

# Security & Authentication
JWT_ACCESS_SECRET=your-super-secret-jwt-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-key-change-in-production
BCRYPT_SALT_ROUNDS=12

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_CURRENCY=usd

# Academic Policies & Configuration
ENROLLMENT_BLOCK_ON_UNPAID=true
MAX_CREDITS_PER_SEMESTER=18
